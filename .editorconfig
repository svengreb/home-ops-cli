# Configurations for EditorConfig.
# References:
#   1. https://editorconfig.org/#file-format-details

# +--------------------+
# + Base Configuration +
# +--------------------+
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 140
trim_trailing_whitespace = true

# +-----------+
# + Languages +
# +-----------+
# +--- Go ---+
[*.{go}]
indent_style = tab

# +--- Markdown ---+
[*.{md}]
max_line_length = off
trim_trailing_whitespace = false
