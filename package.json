{
  "name": "@svengreb/home-ops-cli",
  "version": "0.1.0",
  "description": "CLI for HomeOps",
  "homepage": "https://github.com/svengreb/home-ops-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svengreb/home-ops-cli.git"
  },
  "bugs": {
    "url": "https://github.com/svengreb/home-ops-cli/issues"
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "format": "run-s format:pretty",
    "format:pretty": "prettier --write .",
    "lint": "run-s lint:md lint:pretty",
    "lint:ci": "run-s --continue-on-error lint:ci:*",
    "lint:ci:pretty": "prettier --loglevel silent --check .",
    "lint:md": "remark --no-stdout .",
    "lint:pretty": "prettier --check .",
    "prepare:husky": "husky",
    "prepare": "run-s prepare:*"
  },
  "devDependencies": {
    "@svengreb/remark-preset-lint": ">=0.5.0 <1.0.0",
    "del-cli": "6.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "remark-cli": "11.0.0"
  },
  "dependencies": {}
}
